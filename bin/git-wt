#!/usr/bin/env bash
#
# git-wt — check out a branch here, freeing it from another worktree first.
#
# A branch can only ever be checked out in one worktree at a time (a hard
# git rule). If <branch> is already checked out somewhere else, this detaches
# that OTHER worktree's HEAD (safe — doesn't touch its working tree at all,
# just stops it holding the branch name) and then checks <branch> out right
# here, in the current worktree. No cd, no shell integration needed — this
# operates entirely in the current directory, like any other git-* command.
#
# The argument can be a PR number, a URL, '.'/'@' (the current branch), or a
# plain branch name — same grammar as `git pr`/`git sync`. A PR number/URL is
# resolved to its head branch via `gh` first.
#
# Usage:
#   git wt <branch|PR#|url|.|@>   check that branch out here, freeing it from
#                                 another worktree first if it's there
#   git wt -h                    show this help
#
set -euo pipefail

# Resolve this script's real location (following symlinks — it's installed as
# one) to find lib/gitplus-common.sh, shared across the git-* tools:
# require_git_repo() and free_branch_from_other_worktree() here.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
source "$(cd -P "$(dirname "$_src")/.." && pwd)/lib/gitplus-common.sh"

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
git wt — check out a branch here, freeing it from another worktree first.

If <branch> is already checked out in another worktree, that's normally a
hard stop (a branch can only be checked out in one worktree at a time) — `git
pr <id>`/`git sync <id>` just refuse and tell you where it is. `git wt`
instead detaches that OTHER worktree's HEAD (safe: doesn't touch its working
tree, just frees the branch name) and checks the branch out right here.

The argument can be a PR number, a URL, '.'/'@' (the current branch), or a
plain branch name — same grammar as `git pr`/`git sync`. A PR number/URL is
resolved to its head branch via `gh` first.

Usage:
  git wt <branch|PR#|url|.|@>   check that branch out here
  git wt -h                     show this help
EOF
    exit 0 ;;
esac

require_git_repo "git wt"

id="${1:-}"
[ -z "$id" ] && { echo "git wt: specify a branch or PR number" >&2; exit 2; }

branch="$id"

# '.'/'@' means the current branch (same convention as git pr/git sync).
if [ "$branch" = "." ] || [ "$branch" = "@" ]; then
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
fi

# A PR number or URL resolves to its head branch via `gh`. Falls through to
# treating the original token as a literal branch name if `gh` isn't
# available or the lookup fails (offline, no such PR) — same fallback
# posture as git-sync's resolve_target().
if printf '%s' "$branch" | grep -qE '^[0-9]+$|://'; then
  resolved="$(gh pr view "$branch" --json headRefName --jq '.headRefName' 2>/dev/null || true)"
  [ -n "$resolved" ] && branch="$resolved"
fi

current="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [ "$branch" = "$current" ]; then
  step "already on $branch"
  exit 0
fi

free_branch_from_other_worktree "$branch" || exit 1

if git switch --quiet "$branch" 2>/dev/null; then
  step "switched to $branch"
  exit 0
fi

# Not a local branch (yet) — try creating one tracking origin's, same as
# git-sync's "named target that isn't local yet" fallback.
if git switch --quiet -c "$branch" --track "origin/$branch" >/dev/null 2>&1; then
  step "switched to $branch ${_dim}(new, tracking origin/$branch)${_off}"
  exit 0
fi

echo "git wt: couldn't check out '$branch' — no such local or origin branch (try 'git pr $id' if it's a PR)" >&2
exit 1
