#!/usr/bin/env bash
#
# gp-swap — alias for `gp switch`, which now includes swap's original
# worktree/branch-freeing behavior plus everything real `git switch` does.
# Kept so existing muscle memory and scripts keep working unchanged.
set -eo pipefail
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
BIN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
exec "$BIN_DIR/gp-switch" "$@"
