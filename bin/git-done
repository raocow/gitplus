#!/usr/bin/env bash
#
# git-done — switch back to the base branch and delete the branch you left.
#
# The bookend to `git pr`: after you've checked out a PR's branch and finished
# reviewing it, `git done` returns you to the base (origin's default, usually
# main), fast-forwards it to the latest on origin, and deletes the branch you
# were on.
#
# Safe by default: only deletes the branch you left if it's actually merged
# into the base — checked explicitly with `git merge-base --is-ancestor`, not
# by trusting a bare `git branch -d`. That distinction matters: -d checks
# mergedness against a branch's own upstream when it has one, not against the
# base you're switching to — so a branch that's simply been pushed (true of
# anything that's ever had a PR) passes -d's check regardless of whether it
# was ever merged into base, silently dropping real work.
#
# Squash- and rebase-merged branches are handled too, and have to be: neither
# is an ancestor of the base (a squash is one new commit, a rebase rewrites
# them), so the ancestor test alone would refuse every branch forever in a
# squash-merging repo — the command never doing its job. When that test says
# no, GitHub is asked whether a PR from this branch into THIS base was
# merged. The base match is the point: a stacked PR merged into its PARENT
# branch hasn't reached the base, and is still correctly refused. Offline or
# without gh it falls back to refusing, which is the safe direction; --force
# still deletes regardless.
#
# On a detached HEAD there's nothing to delete, so it just switches back to base.
# If you're already on the base, there's also nothing to delete — it just pulls
# (fetches and fast-forwards the base to origin).
#
# Usage:
#   git done            switch to the base branch, delete the branch you left
#   git done -f         force-delete (unmerged / squash-merged branches)
#   git done -b NAME    switch to NAME as the base instead of origin's default
#   git done -n         dry run — print what it would do, change nothing
#   git done -h         show this help
#
set -euo pipefail

# Resolve this script's real location (following symlinks — it's installed as
# one) to find lib/gitplus-common.sh, shared across the git-* tools: the
# color/step/warn helpers and resolve_base().
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
source "$(cd -P "$(dirname "$_src")/.." && pwd)/lib/gitplus-common.sh"

# Fetch and fast-forward <base> to origin/<base>, narrating the result. Best
# effort: fast-forward only (never a merge commit), note it if diverged/offline.
_ff_base() {
  local base="$1" behind noun
  git show-ref --verify --quiet "refs/remotes/origin/$base" || return 0
  git fetch --quiet origin --prune 2>/dev/null || true
  behind=$(git rev-list --count "$base..origin/$base" 2>/dev/null || echo 0)
  if [ "$behind" -gt 0 ]; then
    if [ "$behind" = 1 ]; then noun=commit; else noun=commits; fi
    if git merge --ff-only "origin/$base" >/dev/null 2>&1; then
      step "fast-forwarded $base to origin/$base ${_dim}(+$behind $noun)${_off}"
    else
      warn "couldn't fast-forward $base (diverged or offline) — left as is"
    fi
  else
    step "$base already up to date with origin/$base"
  fi
}

usage() {
  cat <<'EOF'
git done — switch back to the base branch and delete the branch you left.

The bookend to `git pr`: after reviewing a checked-out PR branch, return to the
base (origin's default, usually main), fast-forward it to origin, and delete the
branch you were on.

Safe by default: only deletes the branch you left if it's actually merged into
the base — checked explicitly (git merge-base --is-ancestor), not via a bare
`git branch -d` (which checks a branch's own upstream when it has one, not the
base — so a merely-pushed branch would pass regardless of whether it was ever
merged). Squash- and rebase-merged branches are handled as well: they aren't
ancestors of the base, so when that test says no, GitHub is asked whether a
PR from this branch into THIS base was merged — a stacked PR merged into its
parent branch hasn't reached the base and is still refused. Needs gh;
offline it falls back to refusing.

Already on the base branch? There's nothing to delete, so it just pulls (fetch
+ fast-forward the base to origin).

Usage:
  git done          switch to the base branch, delete the branch you left
  git done -f       force-delete (unmerged / squash-merged branches)
  git done -b NAME  use NAME as the base instead of origin's default
  git done -n       dry run — print what it would do, change nothing
  git done -h       show this help
EOF
}

dry=0
force=0
base=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -f|--force) force=1 ;;
    -b|--base) shift; base="${1:-}" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "git done: unknown option '$1' (try -h)" >&2; exit 2 ;;
  esac
  shift
done

require_git_repo "git done"

# On a detached HEAD there's no branch to delete — we still switch back to base,
# just skip the deletion at the end.
detached=0
current=$(git rev-parse --abbrev-ref HEAD)
[ "$current" != "HEAD" ] || detached=1

# Base = origin's default branch unless told otherwise (shared with sync/sweep).
base="$(resolve_base "$base")"

git show-ref --verify --quiet "refs/heads/$base" \
  || git show-ref --verify --quiet "refs/remotes/origin/$base" || {
  echo "git done: base '$base' not found locally or on origin" >&2; exit 1; }

# Already on the base: there's no branch to delete, so just bring it up to date
# — fetch and fast-forward it to origin (a pull), then stop.
if [ "$current" = "$base" ]; then
  if [ "$dry" = 1 ]; then
    echo "Would run (on base '$base'):"
    echo "  git fetch origin --prune  &&  git merge --ff-only origin/$base"
    exit 0
  fi
  _ff_base "$base"
  exit 0
fi

if [ "$dry" = 1 ]; then
  echo "Would run:"
  echo "  git switch $base"
  echo "  git fetch origin --prune  &&  git merge --ff-only origin/$base"
  if [ "$detached" = 1 ]; then
    echo "  (detached HEAD — no branch to delete)"
  elif [ "$force" = 1 ]; then
    echo "  git branch -D $current"
  else
    echo "  (delete $current only if merged into $base; refuse otherwise)"
  fi
  exit 0
fi

# --- 1) switch to base (quietly; we narrate it ourselves) ---
git switch --quiet "$base"
step "switched to $base"

# --- 2) fast-forward base to origin so you land on current main. ---
_ff_base "$base"

if [ "$detached" = 1 ]; then
  step "was on a detached HEAD — nothing to delete"
  exit 0
fi

# --- 3) delete the branch you left. NOT via a bare `git branch -d`: -d checks
# mergedness against the branch's own upstream when it has one, not against
# $base/HEAD — so a branch that's simply been pushed (the normal case for
# anything that's ever had a PR) passes trivially, regardless of whether it
# was ever actually merged into $base. git does print a warning for exactly
# this ("merged to 'refs/remotes/origin/<branch>', but not yet merged to
# HEAD") — but that's precisely the case this command exists to refuse, not
# warn about and delete anyway. So mergedness into $base is checked
# explicitly here (same fix already applied in git-sweep for a related
# reason), and -D used either way, since by this point safety has already
# been verified ourselves.
#
# The ancestor test alone isn't enough, though: a SQUASH- or rebase-merged
# branch is never an ancestor of the base (a squash is one new commit, a
# rebase rewrites them), so in a squash-merging repo it would refuse every
# branch forever — the command's whole job, never done. So when the ancestor
# test says no, ask GitHub whether a PR from this branch into THIS base was
# merged; that catches squash/rebase without ever approving work that only
# reached some intermediate branch. Offline or without gh, it just falls
# through to the refusal, which is the safe direction.
sha=$(git rev-parse --short "$current" 2>/dev/null || echo '?')
if [ "$force" = 1 ] || git merge-base --is-ancestor "$current" "$base" 2>/dev/null; then
  git branch -D "$current" >/dev/null 2>&1
  step "deleted $current ${_dim}(was $sha)${_off}"
elif pr_num="$(pr_merged_into "$current" "$base")"; then
  git branch -D "$current" >/dev/null 2>&1
  step "deleted $current ${_dim}(was $sha; squash-merged as #$pr_num)${_off}"
else
  warn "kept $current — not fully merged into $base"
  printf '  %sif you are sure it is done (e.g. squash-merged): git branch -D %s%s\n' \
    "$_dim" "$current" "$_off" >&2
  exit 1
fi
