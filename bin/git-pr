#!/usr/bin/env bash
#
# git-pr — list your open PRs, check one out, or merge one or more.
#
#   git pr                list your open PRs in this repo, as "<url> -- <title>"
#   git pr --no-title     just the URLs, one per line (easy to pipe)   [-nt]
#   git pr --copy         also copy the listing to the clipboard         [-c]
#   git pr <n|branch>     check out that PR's branch, updated to the PR's latest
#   git pr list <ids...>  show title/link for specific PR(s) instead of
#                         checking out — any count, any author, any state
#   git pr <ids...>       (2+ ids, or -x, or a range) same as `git pr list
#                         <ids...>` — kept for backward compatibility
#   git pr merge <ids...> merge specific PR(s) (number, branch, URL, or a
#                         "NNN-MMM" range — all mixable)
#   git pr merge --all    merge every mergeable PR you authored   [-a]
#   git pr ... -x <ids...>   exclude PR(s) from any of the above   [--exclude]
#
# The checkout/list argument (and each merge argument) can be a PR number, a
# head branch name, or a PR URL — whatever `gh` can resolve to a pull request.
# It can also be "." or "@", meaning the branch you're currently on (the PR
# for the current branch — same idea as `gh pr view` with no argument); this
# works anywhere an id is accepted, so `git pr list .` shows the current
# branch's PR, `git pr .` checks it out, `git pr merge .` merges it. Bare
# `git pr` / `git pr list` with no token still lists all your open PRs.
# Checkout uses `gh pr checkout`, which creates the branch or fast-forwards an
# existing one to the PR's latest — so you're never on a stale copy. For a
# merged/closed PR whose head branch was deleted from origin, it falls back to
# `refs/pull/<n>/head`; if GitHub is unreachable, it falls back to a local
# branch (the stamped one for a number, or the named branch itself), switched
# to as-is (not updated).
#
# `git pr <id>` (no subcommand, exactly one plain id, no -x) checks that PR
# out — you can't check out more than one at once. To just see a single PR's
# title/link without touching your working tree, say so explicitly with
# `git pr list <id>`. Naming PRs explicitly (via `list` or bare multi/range/-x,
# the latter kept for old muscle memory) isn't scoped to you — same principle
# as `git pr merge <ids>` — and shows every state (open, closed, merged), not
# just open.
#
# `git pr merge` touches shared remote state (it merges PRs on GitHub), but it
# acts by default — pass -n/--dry-run to preview first. There is no --force;
# anything blocked by branch protection (required reviews/checks) is always
# left alone, never bypassed.
#
# `git pr merge <ids...>` merges exactly the PRs you named, whoever authored
# them (same as naming a PR to `gh pr merge` — you're being explicit, so it's
# not scoped to your own). `git pr merge --all` has no ids and is a broad
# sweep, so THAT form only ever considers PRs YOU authored — merging someone
# else's PR isn't a sweep's call to make.
#
# An id may be a "NNN-MMM" range of PR numbers (either order), expanded into
# individual ids — a token only counts as a range if it's ENTIRELY digits, so
# a branch name like "task-42" passes through untouched. -x/--exclude takes
# one or more ids (same forms, plus ranges) to drop from either --all or an
# explicit id list — everything after -x is an exclude until the next flag.
# Duplicate/excluded ids that resolve to the same PR are each counted once.
#
# Merge order: it computes which of the targeted PRs touch overlapping files
# and processes the least-entangled ones first (fewest others sharing a
# changed file), so a PR that's easy to land doesn't sit behind one that needs
# a rebase. This is a static, one-time ordering from each PR's changed-file
# list — no LLM, no guessing, just a conflict-adjacency count.
#
# For each PR, in that order:
#   - mergeStateStatus CLEAN/UNSTABLE  → merge it directly (gh pr merge).
#   - BEHIND                           → try a direct merge first — GitHub's
#                                         own merge does a real three-way merge
#                                         server-side and often succeeds with
#                                         no local rebase at all. Only on
#                                         failure does it fall back to the
#                                         DIRTY path below.
#   - DIRTY                            → rebase the branch onto its base in a
#                                         scratch worktree (never touches your
#                                         current branch/worktree) and push; if
#                                         the rebase itself hits conflicts,
#                                         abort it and skip — that needs a human.
#   - BLOCKED (required checks/reviews) → skip; never bypassed.
#   - draft                            → skip.
# Every merge attempt retries a few times with a short pause on failure —
# right after a push, GitHub can take a moment to recompute mergeability, so
# a bare first attempt can fail even though the PR is genuinely mergeable.
# Skipped PRs are listed at the end with why. Merging one PR can change the
# status of the ones after it (e.g. newly BEHIND) — each PR's status is
# re-checked right before it's handled, not just at the start.
#
# The merge method (merge/squash/rebase) defaults to the repo's own default
# (`gh repo view`'s viewerDefaultMergeMethod), or --method to override. Branches
# are never auto-deleted after merge — run `git sweep` afterward for that.
#
# (Named `git pr`, not `git switch`: git always prefers its built-in `switch`
# over a script, so a custom `git-switch` could never run. A branch literally
# named "merge" can't be checked out with `git pr merge` for the same reason
# `merge` is claimed as a subcommand — use `git pr merge merge` if you must.)
#
# Usage:
#   git pr                          list open PRs you authored ("<url> -- <title>")
#   git pr -nt                      list them as bare URLs (--no-title)
#   git pr <n|branch>                check out a PR by number, branch name, or URL
#   git pr <ids...>                 (2+, or -x, or a range) list exactly those
#                                   PRs instead — any author, any state
#   git pr merge <n|branch|range>... merge the given PR(s); "824-830" is a range
#   git pr merge --all              merge every mergeable PR you authored (-a)
#   git pr ... -x <ids...>          exclude PR(s) (--exclude; also takes ranges)
#   git pr merge ... -n             preview instead (--dry-run)
#   git pr merge ... --method squash|merge|rebase   override the merge method
#   git pr -h                       show this help
#
set -euo pipefail

# Resolve this script's real location (following symlinks — it's installed as
# one) to find lib/gitplus-common.sh, shared across the git-* tools: the
# color/step/warn helpers and expand_ranges().
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
source "$(cd -P "$(dirname "$_src")/.." && pwd)/lib/gitplus-common.sh"

usage() {
  cat <<'EOF'
git pr — list your open PRs, check one out, or merge one or more.

  git pr                      list your open PRs in this repo, as "<url> -- <title>"
  git pr -nt                  list them as bare URLs (--no-title)
  git pr -c                   also copy the listing to the clipboard (--copy;
                              works with list/checkout-multi/-nt, not merge)
  git pr <n|branch>           check out that PR (by number, branch name, or
                              URL), updated to the PR's latest
  git pr list <ids...>        show title/link for specific PR(s) instead of
                              checking out — any count, any author, any state
  git pr list .               show the PR for the CURRENT branch ('.' or '@'
                              means the branch you're on — works anywhere an
                              id is accepted: list, checkout, merge, -x)
  git pr <ids...>             2+ ids (or -x, or a range): same as `git pr
                              list <ids...>` — kept for backward compatibility
  git pr merge <ids...>       merge the given PR(s) (number, branch, URL, or a
                              "824-830" range — all mixable), rebasing what
                              needs it, skipping what needs a human
  git pr merge --all          merge every mergeable PR YOU authored (-a)
  git pr ... -x <ids>         exclude PR(s) from any of the above (--exclude;
                              also takes ranges — everything after -x is
                              excluded until the next flag)
  git pr merge ... -n         preview instead: show the plan, change nothing
  git pr -h                   show this help

Uses the GitHub CLI (gh). Checkout falls back to refs/pull/<n>/head for deleted
branches, or (offline) to the local branch.

`git pr <id>` (no subcommand, exactly one plain id, no -x) checks it out — you
can't check out more than one PR at once. To see a single PR's title/link
without touching your working tree, say so explicitly with `git pr list <id>`.
Naming PRs explicitly (via `list`, or bare multi/range/-x — kept for old
muscle memory) isn't scoped to you.

`git pr merge <ids>` merges exactly the PRs you named, whoever authored them.
`git pr merge --all` (no ids) is a broad sweep, so it only ever considers PRs
YOU authored — merging someone else's PR isn't a sweep's call to make. Branch
protection (required reviews/checks) is never bypassed either way. PRs are
merged in an order chosen to minimize conflicts — the least-entangled ones
(fewest others touching the same files) go first. A PR needing a rebase gets
one, in a scratch worktree that never touches your current branch; if the
rebase itself conflicts, that PR is skipped for you to resolve by hand.

  git pr merge 824-830 -x 825 827   merge #824-830 except #825 and #827

  git pr merge ... --method squash|merge|rebase   override the merge method
                                (default: the repo's own default merge method)
EOF
}

id=""
notitle=0
copy=0
subcmd=""
all=0
dry=0
method=""
raw_targets=()   # positional args before -x: ids and/or "NNN-MMM" ranges
raw_excludes=()  # positional args after -x/--exclude
in_exclude=0     # once -x is seen, bare tokens go to raw_excludes until another flag

# `merge`/`list` are subcommands, not flags: `git pr merge <ids...>` / `--all`,
# `git pr list <ids...>`.
if [ "${1:-}" = "merge" ]; then subcmd="merge"; shift;
elif [ "${1:-}" = "list" ]; then subcmd="list"; shift; fi

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -nt|--no-title) notitle=1; in_exclude=0 ;;
    -c|--copy) copy=1; in_exclude=0 ;;
    -a|--all) all=1; in_exclude=0 ;;
    -n|--dry-run) dry=1; in_exclude=0 ;;
    -x|--exclude) in_exclude=1 ;;
    --method) shift; method="${1:-}"; in_exclude=0 ;;
    -*) echo "git pr: unknown option '$1' (try -h)" >&2; exit 2 ;;
    *)
      if [ "$in_exclude" = 1 ]; then raw_excludes+=("$1"); else raw_targets+=("$1"); fi
      ;;
  esac
  shift
done

if [ "$subcmd" = "merge" ]; then
  if [ "$all" = 1 ] && [ "${#raw_targets[@]}" -gt 0 ]; then
    echo "git pr merge: can't combine --all with specific PRs" >&2; exit 2
  fi
  if [ "$all" = 0 ] && [ "${#raw_targets[@]}" -eq 0 ]; then
    echo "git pr merge: specify PR(s) to merge (number, branch, or URL — 'NNN-MMM' for a range), or --all for every one of your open PRs" >&2; exit 2
  fi
else
  # --all is also valid here (explicitly "all my open PRs", same meaning as
  # the implicit default when no targets are given) so its grammar mirrors
  # `git pr merge --all`; -n/--method genuinely don't apply to listing.
  if [ "$dry" = 1 ] || [ -n "$method" ]; then
    echo "git pr: --dry-run/--method only apply to 'git pr merge'" >&2; exit 2
  fi
  if [ "$all" = 1 ] && [ "${#raw_targets[@]}" -gt 0 ]; then
    echo "git pr: can't combine --all with specific PRs" >&2; exit 2
  fi
fi

require_git_repo "git pr"

# A target or exclude of '.' or '@' means the current branch — the PR for the
# branch you're on (same idea as `gh pr view` with no argument). Resolve it to
# the real branch name up front so every downstream path (checkout, list,
# exclude) treats it like any other branch name. This is an explicit extra
# token, not a change to the default: bare `git pr` / `git pr list` still
# lists all your open PRs. ('.'/'@' can't be a real PR number or branch name,
# so claiming them collides with nothing.)
_here=0
if [ "${#raw_targets[@]}" -gt 0 ]; then
  for t in "${raw_targets[@]}"; do case "$t" in .|@) _here=1 ;; esac; done
fi
if [ "${#raw_excludes[@]}" -gt 0 ]; then
  for t in "${raw_excludes[@]}"; do case "$t" in .|@) _here=1 ;; esac; done
fi
if [ "$_here" = 1 ]; then
  here_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [ -z "$here_branch" ] || [ "$here_branch" = HEAD ]; then
    echo "git pr: '.'/'@' means the current branch, but you're on a detached HEAD" >&2; exit 1
  fi
  i=0; while [ "$i" -lt "${#raw_targets[@]}" ]; do
    case "${raw_targets[$i]}" in .|@) raw_targets[$i]="$here_branch" ;; esac; i=$((i + 1))
  done
  i=0; while [ "$i" -lt "${#raw_excludes[@]}" ]; do
    case "${raw_excludes[$i]}" in .|@) raw_excludes[$i]="$here_branch" ;; esac; i=$((i + 1))
  done
fi

# expand_ranges (shared, from lib/gitplus-common.sh) expands "NNN-MMM"
# range tokens into individual ids — a token only counts as a range if it's
# ENTIRELY digits-hyphen-digits, so a branch name like "task-42" passes
# through untouched. Applied to both the target list and the exclude list,
# so -x accepts ranges too.
merge_ids=()
[ "${#raw_targets[@]}" -gt 0 ] && expand_ranges "git pr" merge_ids "${raw_targets[@]}"
exclude_ids=()
[ "${#raw_excludes[@]}" -gt 0 ] && expand_ranges "git pr" exclude_ids "${raw_excludes[@]}"

# No-subcommand dispatch: exactly one plain (non-range) target and no
# excludes still means "check out this PR" (the original, heavily-used
# behavior) — anything more flexible (multiple ids, a range, or -x) means
# "list this specific set" instead, since you can't check out more than one
# PR at once. `git pr list <id>` always means list, even for a single plain
# id — that's the whole point of naming the subcommand explicitly.
if [ "$subcmd" = "" ] && [ "${#raw_targets[@]}" -eq 1 ] && [ "${#raw_excludes[@]}" -eq 0 ] \
  && ! printf '%s' "${raw_targets[0]}" | grep -qE '^[0-9]+-[0-9]+$'; then
  id="${raw_targets[0]}"
fi

require_gh "git pr"

# ══════════════════════════════════════════════════════════════════════════
# git pr merge: merge specific PR(s), or --all mergeable PRs you authored.
# ══════════════════════════════════════════════════════════════════════════
if [ "$subcmd" = "merge" ]; then
  [ -n "$method" ] && method="$(printf '%s' "$method" | tr '[:upper:]' '[:lower:]')"
  case "$method" in
    ""|merge|squash|rebase) ;;
    *) echo "git pr merge: --method must be merge, squash, or rebase" >&2; exit 2 ;;
  esac

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  files_dir="$tmp/files"
  mkdir -p "$files_dir"

  # Resolve the merge method: explicit --method, else the repo's own default
  # (gh repo view's viewerDefaultMergeMethod comes back UPPERCASE), else squash.
  if [ -z "$method" ]; then
    method="$(gh repo view --json viewerDefaultMergeMethod --jq '.viewerDefaultMergeMethod // ""' 2>/dev/null || true)"
    method="$(printf '%s' "$method" | tr '[:upper:]' '[:lower:]')"
    case "$method" in merge|squash|rebase) ;; *) method=squash ;; esac
  fi
  merge_flag="--$method"
  skipped=()

  # Resolve -x/--exclude ids to PR numbers up front (an exclude that doesn't
  # resolve to anything is just a no-op, not an error — it may already be
  # closed, which is what you wanted anyway).
  exclude_nums=""
  for xid in "${exclude_ids[@]}"; do
    xn="$(gh pr view "$xid" --json number --jq '.number' 2>/dev/null || true)"
    [ -n "$xn" ] && exclude_nums="$exclude_nums $xn"
  done

  # Gather the PR numbers to work on. --all is a broad sweep, so it's scoped
  # to PRs YOU authored — merging someone else's PR isn't a sweep's call to
  # make. Explicit ids are resolved (number/branch/URL, whoever authored them)
  # and deduped, since the same PR could be named twice (e.g. by number and by
  # branch). -x/--exclude removes matching PRs from either set.
  if [ "$all" = 1 ]; then
    nums=""
    for n in $(gh pr list --state open --author "@me" --limit 200 --json number --jq '.[].number' 2>/dev/null || true); do
      case " $exclude_nums " in *" $n "*) continue ;; esac
      nums="$nums $n"
    done
    if [ -z "$nums" ]; then
      echo "git pr merge: no open PRs authored by you in this repo (after --exclude)."
      exit 0
    fi
  else
    nums=""; seen_nums=""
    for mid in "${merge_ids[@]}"; do
      n="$(gh pr view "$mid" --json number,state --jq 'select(.state == "OPEN") | .number' 2>/dev/null || true)"
      if [ -z "$n" ]; then
        skipped+=("$mid -- couldn't resolve to an open PR")
        continue
      fi
      case " $seen_nums " in *" $n "*) continue ;; esac
      seen_nums="$seen_nums $n"
      case " $exclude_nums " in *" $n "*) skipped+=("#$n -- excluded"); continue ;; esac
      nums="$nums $n"
    done
    if [ -z "$nums" ]; then
      echo "git pr merge: none of the given PR(s) could be resolved (or all were excluded)."
      if [ "${#skipped[@]}" -gt 0 ]; then
        echo "Skipped:"; for s in "${skipped[@]}"; do echo "  $s"; done
      fi
      exit 0
    fi
  fi

  overlap_input="$tmp/overlap_input"; : > "$overlap_input"
  titles_file="$tmp/titles"; : > "$titles_file"

  cand=()
  for num in $nums; do
    info="$(gh pr view "$num" --json headRefName,baseRefName,isDraft,title \
      --jq '"\(.headRefName)\t\(.baseRefName)\t\(.isDraft)\t\(.title)"' 2>/dev/null)" || continue
    head="${info%%$'\t'*}"; rest="${info#*$'\t'}"
    base="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    draft="${rest%%$'\t'*}"; title="${rest#*$'\t'}"
    printf '%s\t%s\t%s\n' "$num" "$head" "$base" >> "$tmp/meta"
    printf '%s\t%s\n' "$num" "$title" >> "$titles_file"
    if [ "$draft" = "true" ]; then
      skipped+=("#$num $title -- draft")
      continue
    fi
    gh pr view "$num" --json files --jq '.files[].path' 2>/dev/null | sort -u > "$files_dir/$num"
    cand+=("$num")
  done

  if [ "${#cand[@]}" -eq 0 ]; then
    echo "git pr merge: nothing to merge (all given PRs are drafts or unreadable)."
    if [ "${#skipped[@]}" -gt 0 ]; then
      echo "Skipped:"; for s in "${skipped[@]}"; do echo "  $s"; done
    fi
    exit 0
  fi

  # Order candidates by conflict-adjacency: for each PR, count how many other
  # candidates share at least one changed file; sort ascending (least-entangled
  # first), tie-break by PR number.
  #
  # Built as an inverted index (file -> the PRs that touch it) rather than a
  # pairwise scan over every PR pair: cost scales with the total number of
  # changed files, not the square of the PR count, so it stays fast even with
  # a large open-PR count (most files belong to exactly one PR and cost
  # nothing here; only files shared by multiple PRs do any work).
  cand_list="$tmp/cand_list"; printf '%s\n' "${cand[@]}" > "$cand_list"
  pairs="$tmp/pairs"; : > "$pairs"
  for num in "${cand[@]}"; do
    [ -s "$files_dir/$num" ] || continue
    sed "s/\$/\t$num/" "$files_dir/$num" >> "$pairs"
  done
  awk -F'\t' '
    FNR == NR { allnums[$1] = 1; next }
    { byfile[$1] = byfile[$1] " " $2 }
    END {
      for (f in byfile) {
        n = split(byfile[f], nums, " ")
        for (i = 1; i <= n; i++)
          for (j = 1; j <= n; j++) {
            if (i == j) continue
            key = nums[i] SUBSEP nums[j]
            if (!(key in seen)) { seen[key] = 1; ov[nums[i]]++ }
          }
      }
      for (p in allnums) printf "%d\t%s\n", (p in ov ? ov[p] : 0), p
    }
  ' "$cand_list" "$pairs" > "$overlap_input"
  order=()
  while IFS=$'\t' read -r _ovnum num; do order+=("$num"); done < <(sort -n -k1,1 -k2,2 "$overlap_input")

  title_of() { grep -m1 "^$1"$'\t' "$titles_file" | cut -f2-; }
  meta_of()  { grep -m1 "^$1"$'\t' "$tmp/meta"; }   # num\thead\tbase

  # Retry `gh pr merge` a few times with a short pause. Right after a push,
  # GitHub can take a moment to recompute mergeability — an immediate merge
  # attempt can fail even though the PR is genuinely mergeable, which used to
  # mean skipping and telling you to rerun the whole command just to wait a
  # few seconds. Bounded (not indefinite), so a real failure still surfaces
  # promptly. Prints the last attempt's output; exit status is its own.
  merge_with_retry() {
    local num="$1" tries=0 err
    while true; do
      if err="$(gh pr merge "$num" "$merge_flag" 2>&1)"; then
        printf '%s' "$err"; return 0
      fi
      tries=$((tries + 1))
      [ "$tries" -ge 3 ] && { printf '%s' "$err"; return 1; }
      sleep 2
    done
  }

  # Rebase a PR's branch onto its base in a scratch worktree, then push. Never
  # touches the current worktree/branch. Returns 0 on a clean rebase (and
  # leaves it pushed), 1 if the rebase itself needs manual resolution.
  rebase_and_push() {
    local head="$1" base="$2"
    # -x for a whole-LINE match, not just -F with a trailing literal newline
    # appended to the pattern: real (BSD/FreeBSD) grep on macOS treats an
    # embedded \n inside a -F pattern as a pattern SEPARATOR, splitting it
    # into two patterns — the real string, and an empty one after the \n.
    # An empty pattern matches every line, so `grep -qF "...$branch"$'\n'`
    # silently matched ANY worktree output at all, making this guard always
    # fire (skip every PR needing a rebase) regardless of real state. Found
    # because it happened to work fine when tested through Claude Code's
    # interactive shell, which transparently substitutes a different grep
    # implementation (ugrep) that doesn't have this quirk — but the real
    # /usr/bin/grep the script actually runs with does.
    if git worktree list --porcelain | grep -qFx "branch refs/heads/$head"; then
      return 2   # branch is checked out elsewhere — don't touch it
    fi
    local wt; wt="$tmp/wt-$head"
    git fetch --quiet origin "$head" "$base" 2>/dev/null || return 3
    git worktree add --quiet -B "$head" "$wt" "origin/$head" >/dev/null 2>&1 || return 3
    local ok=0
    if (cd "$wt" && git rebase --quiet "origin/$base" >/dev/null 2>&1); then
      if (cd "$wt" && git push --quiet --force-with-lease "origin" "HEAD:$head" >/dev/null 2>&1); then
        ok=0
      else
        ok=4   # rebased locally but couldn't push (protected ref, race, etc.)
      fi
    else
      (cd "$wt" && git rebase --abort >/dev/null 2>&1) || true
      ok=1
    fi
    git worktree remove --force "$wt" >/dev/null 2>&1 || true
    return "$ok"
  }

  merged=()
  plan=()   # dry-run: "#n title -- action" lines

  for num in "${order[@]}"; do
    title="$(title_of "$num")"
    meta="$(meta_of "$num")"; head="$(printf '%s' "$meta" | cut -f2)"; base="$(printf '%s' "$meta" | cut -f3)"

    status="$(gh pr view "$num" --json mergeStateStatus --jq '.mergeStateStatus' 2>/dev/null || echo UNKNOWN)"

    case "$status" in
      CLEAN|UNSTABLE)
        if [ "$dry" = 1 ]; then
          plan+=("#$num $title -- merge ($method)"); continue
        fi
        if err="$(merge_with_retry "$num")"; then
          step "merged #$num ${_dim}($title)${_off} ${_branch}[$head -> $base]${_off}"
          merged+=("#$num $title")
        else
          warn "merge failed for #$num — ${err##*$'\n'}"
          skipped+=("#$num $title -- merge failed: ${err##*$'\n'}")
        fi
        ;;
      BEHIND|DIRTY)
        if [ "$dry" = 1 ]; then
          if [ "$status" = "BEHIND" ]; then
            plan+=("#$num $title -- try direct merge, else rebase onto $base")
          else
            plan+=("#$num $title -- rebase onto $base, then merge")
          fi
          continue
        fi
        # BEHIND (not DIRTY) means GitHub hasn't found a textual conflict —
        # its own merge does a real three-way merge server-side and often
        # succeeds with no local rebase at all. Try that first and only fall
        # back to rebasing if it fails. DIRTY means GitHub already found a
        # real conflict, so go straight to rebasing.
        merged_directly=0
        if [ "$status" = "BEHIND" ] && gh pr merge "$num" "$merge_flag" >/dev/null 2>&1; then
          step "merged #$num ${_dim}($title, no rebase needed)${_off} ${_branch}[$head -> $base]${_off}"
          merged+=("#$num $title")
          merged_directly=1
        fi
        if [ "$merged_directly" = 0 ]; then
          # `cmd; rc=$?` looks like it captures the exit code, but under
          # `set -e` a plain (non-conditional) command returning non-zero
          # aborts the script right there — before `rc=$?` ever runs. The `||`
          # form is required: putting the call on the left of `||` exempts it
          # from errexit, and `rc=$?` on the right still captures its real
          # exit code. Without this, ANY non-zero return from rebase_and_push
          # (conflict, branch checked out elsewhere, fetch/push failure) would
          # silently kill the entire `git pr merge` run with no message at
          # all, instead of warning and skipping just this one PR.
          rc=0; rebase_and_push "$head" "$base" || rc=$?
          case "$rc" in
            0)
              if err="$(merge_with_retry "$num")"; then
                step "rebased + merged #$num ${_dim}($title)${_off} ${_branch}[$head -> $base]${_off}"
                merged+=("#$num $title")
              else
                warn "rebased #$num but merge still hasn't gone through — rerun 'git pr merge $num' to retry"
                skipped+=("#$num $title -- rebased and pushed; merge pending (rerun to retry)")
              fi
              ;;
            1) warn "skipping #$num — rebase needs manual conflict resolution"
               skipped+=("#$num $title -- rebase conflicts, needs manual resolution") ;;
            2) warn "skipping #$num — branch '$head' is checked out in a worktree"
               skipped+=("#$num $title -- branch checked out elsewhere") ;;
            *) warn "skipping #$num — couldn't fetch/rebase '$head'"
               skipped+=("#$num $title -- couldn't rebase (fetch/push failed)") ;;
          esac
        fi
        ;;
      BLOCKED)
        [ "$dry" = 1 ] && { plan+=("#$num $title -- skip: blocked (required checks/reviews)"); continue; }
        warn "skipping #$num — blocked by required checks or reviews"
        skipped+=("#$num $title -- blocked (required checks or reviews)")
        ;;
      *)
        if [ "$dry" = 1 ]; then
          plan+=("#$num $title -- attempt merge ($status)"); continue
        fi
        if err="$(merge_with_retry "$num")"; then
          step "merged #$num ${_dim}($title)${_off} ${_branch}[$head -> $base]${_off}"
          merged+=("#$num $title")
        else
          warn "skipping #$num — $status: ${err##*$'\n'}"
          skipped+=("#$num $title -- $status: ${err##*$'\n'}")
        fi
        ;;
    esac
  done

  if [ "$dry" = 1 ]; then
    echo
    echo "Dry run — nothing was changed. Order (least-entangled first):"
    for p in "${plan[@]}"; do echo "  $p"; done
    [ "${#skipped[@]}" -gt 0 ] && { echo "Would skip:"; for s in "${skipped[@]}"; do echo "  $s"; done; }
    echo
    echo "Run without --dry-run to actually merge."
  else
    # Each merge/skip was already narrated as it happened (the ✓/! lines
    # above) — re-listing every success here by name was pure repetition.
    # Skips still get listed: unlike a success, "why" is worth having in one
    # place to act on, not just scroll back to find. When everything merged
    # cleanly, the one-line tally is a direct continuation of that narration,
    # not a separate section — no blank line needed. The skip list IS a
    # separate section worth setting apart, so it keeps its lead-in blank line.
    if [ "${#skipped[@]}" -eq 0 ]; then
      echo "Merged all ${#merged[@]}."
    else
      echo
      echo "Merged ${#merged[@]}; unmergeable/skipped (${#skipped[@]}):"
      for s in "${skipped[@]}"; do echo "  $s"; done
    fi
  fi
  exit 0
fi

# ══════════════════════════════════════════════════════════════════════════
# No single checkout target: list PRs (titles by default) instead. Reached
# via explicit `git pr list ...` (any target count, including one) or the
# implicit bare form (2+ targets, a range, or -x, kept for backward compat).
#   - no targets → your open PRs (optionally minus -x excludes)
#   - targets    → exactly those PRs, any author, any state (naming them
#     explicitly is not scoped to you — same principle as `git pr merge
#     <ids>`), optionally minus -x excludes
# ══════════════════════════════════════════════════════════════════════════
if [ "$subcmd" != "merge" ] && [ -z "$id" ]; then
  rows=""
  if [ "${#merge_ids[@]}" -eq 0 ]; then
    gh_err=$(mktemp)
    rc=0
    rows="$(gh pr list --author "@me" --state open --limit 100 --json number,url,title \
      --jq '.[] | "\(.number)\t\(.url)\t\(.title)"' 2>"$gh_err")" || rc=$?
    err="$(cat "$gh_err")"; rm -f "$gh_err"
    if [ "$rc" -ne 0 ]; then
      echo "git pr: couldn't list PRs — ${err:-gh pr list failed (exit $rc)}" >&2
      exit 1
    fi
  else
    for tid in "${merge_ids[@]}"; do
      row="$(gh pr view "$tid" --json number,url,title,state \
        --jq '"\(.number)\t\(.url)\t\(.title)\t\(.state)"' 2>/dev/null || true)"
      [ -n "$row" ] && rows="$rows
$row"
    done
  fi

  if [ "${#exclude_ids[@]}" -gt 0 ]; then
    exclude_nums=""
    for xid in "${exclude_ids[@]}"; do
      xn="$(gh pr view "$xid" --json number --jq '.number' 2>/dev/null || true)"
      [ -n "$xn" ] && exclude_nums="$exclude_nums $xn"
    done
    filtered=""
    while IFS=$'\t' read -r num rest; do
      [ -z "$num" ] && continue
      case " $exclude_nums " in *" $num "*) continue ;; esac
      filtered="$filtered
$num	$rest"
    done <<EOF
$rows
EOF
    rows="$filtered"
  fi

  listing="$(printf '%s\n' "$rows" | sed '/^$/d' | sort -t "$(printf '\t')" -k1,1n -u \
    | while IFS=$'\t' read -r num url title state; do
        line="$url"
        [ "$notitle" = 1 ] || line="$url -- $title"
        [ -n "${state:-}" ] && [ "$state" != "OPEN" ] && line="$line [$state]"
        echo "$line"
      done)"
  if [ -n "$listing" ]; then
    printf '%s\n' "$listing"
  elif [ "${#merge_ids[@]}" -eq 0 ]; then
    # Genuinely zero PRs is a normal, valid state — but silence here reads
    # identically whether that's true or the wrong `gh` account is active
    # (e.g. an unrelated identity that's never authored anything in this
    # repo). Naming who was actually queried turns that ambiguity into an
    # immediate, checkable fact instead of a guess.
    me="$(gh api user --jq .login 2>/dev/null || echo '?')"
    warn "no open PRs authored by $me in this repo — check 'gh auth status' if that's not who you expected"
  fi
  if [ "$copy" = 1 ] && [ -n "$listing" ]; then
    printf '%s\n' "$listing" | pbcopy
    printf '%s✓%s %s\n' "$_ok" "$_off" "copied to clipboard" >&2
  fi
  exit 0
fi

# ══════════════════════════════════════════════════════════════════════════
# An argument: check out that PR, updated to its latest.
# ══════════════════════════════════════════════════════════════════════════
# Resolve the PR from the id (number, branch, or URL) first — this gives us the
# PR number + head branch, and doubles as the online/offline signal.
info=$(gh pr view "$id" --json number,headRefName -q '"\(.number) \(.headRefName)"' 2>/dev/null || true)

if [ -n "$info" ]; then
  num=${info%% *}; branch=${info#* }
  # A branch already checked out in another worktree can't be checked out
  # here too (a hard git rule) — `gh pr checkout` fails on it exactly like it
  # fails on a merged PR's deleted head branch, so without freeing it first
  # the code below would misdiagnose this as "gone from origin" and try a
  # fetch/switch that's equally doomed, ending in a confusing "may have
  # diverged" error for a branch that's actually fine, just in use
  # somewhere else. Freeing it (detaching that worktree's HEAD — safe, its
  # working tree is untouched) means checkout just works normally below.
  free_branch_from_other_worktree "$branch" || exit 1
  # gh pr checkout creates the branch or fast-forwards an existing one, leaving
  # us on it.
  if gh pr checkout "$id" >/dev/null 2>&1; then
    git config "branch.$branch.gitplus-pr" "$num" 2>/dev/null || true
    step "switched to $branch ${_dim}(PR #$num, up to date)${_off}"
    exit 0
  fi
  # Resolved the PR but checkout failed — usually a merged/closed PR whose head
  # branch was deleted from origin. Use the ref GitHub keeps around.
  warn "head branch gone from origin — using refs/pull/$num/head"
  if git fetch --quiet origin "refs/pull/$num/head:$branch" 2>/dev/null; then
    git switch --quiet "$branch"
    git config "branch.$branch.gitplus-pr" "$num" 2>/dev/null || true
    step "switched to $branch ${_dim}(PR #$num)${_off}"
  else
    echo "git pr: couldn't check out PR #$num — '$branch' may have diverged; resolve by hand" >&2
    exit 1
  fi
  exit 0
fi

# gh couldn't resolve $id (GitHub unreachable, or no PR for it). Fall back to a
# local branch: the stamped one for a number, or the named branch itself.
if printf '%s' "$id" | grep -qE '^[0-9]+$'; then
  stamped=$(git config --get-regexp '^branch\..*\.gitplus-pr$' 2>/dev/null \
    | awk -v n="$id" '$2 == n { print $1; exit }' \
    | sed -E 's/^branch\.(.*)\.gitplus-pr$/\1/') || true
  if [ -n "${stamped:-}" ] && git show-ref --verify --quiet "refs/heads/$stamped"; then
    git switch --quiet "$stamped"
    warn "couldn't reach GitHub — on existing $stamped (not updated)"
    exit 0
  fi
  echo "git pr: couldn't find PR #$id (offline, or not a PR in this repo)" >&2; exit 1
elif git show-ref --verify --quiet "refs/heads/$id"; then
  git switch --quiet "$id"
  warn "couldn't resolve a PR for '$id' via gh — switched to local branch as-is"
  exit 0
else
  echo "git pr: couldn't resolve '$id' to a PR or local branch" >&2; exit 1
fi
