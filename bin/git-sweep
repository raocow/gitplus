#!/usr/bin/env bash
#
# git-sweep — delete local branches already merged into the base branch.
#
# Fetches first and compares against the base's REMOTE tip (origin/<base>), so it
# works without pulling the base locally and from any branch you're on — a branch
# merged upstream is swept even if your local main is stale.
#
# Safe by default: only deletes branches whose tip is already an ancestor of the
# base's remote tip (verified with `git merge-base --is-ancestor`), so it can't
# drop unmerged work. Unlike a bare `git branch -d` it isn't fooled by a stale
# local base — `-d` rechecks against your current branch, which wrongly refuses
# branches merged upstream when local <base> lags. Note: squash-merged branches
# are NOT caught — a squash makes a new commit, so it isn't an ancestor.
#
# --force widens the net: it targets EVERY local branch (except the base and the
# current one) and force-deletes with `git branch -D` — so it also clears
# branches that were never PR'd/merged and squash-merged leftovers. This DELETES
# UNMERGED WORK; use `-n` first to see exactly what it would remove.
#
# Naming branch(es) targets just those instead of the whole repo — same rules
# apply: safe by default (skips a named branch that isn't merged, same
# ancestor check), --force deletes it regardless. Refuses to name the base or
# current branch.
#
# Usage:
#   git sweep            delete local branches merged into the base (safe, -d)
#   git sweep <branch...> delete just the given branch(es) (safe unless -f)
#   git sweep -f         force: -D every local branch except base + current
#   git sweep -n         dry run — list what would be deleted, change nothing
#   git sweep -b NAME    base branch to compare against (default: origin's default)
#   git sweep -h         show this help
#
set -euo pipefail

# Resolve this script's real location (following symlinks — it's installed as
# one) to find lib/gitplus-common.sh, shared across the git-* tools: the
# color/step/warn helpers and resolve_base().
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
source "$(cd -P "$(dirname "$_src")/.." && pwd)/lib/gitplus-common.sh"

usage() {
  cat <<'EOF'
git sweep — delete local branches already merged into the base branch.

Safe by default: only deletes branches already merged into the base's remote
tip (verified with merge-base), so it never drops unmerged work — and unlike a
bare `git branch -d` it isn't fooled by a stale local base. Squash-merged
branches are NOT caught (a squash isn't an ancestor).

--force targets EVERY local branch except the base and current one and deletes
with `git branch -D` — clearing never-PR'd / squash-merged / unmerged branches
too. This deletes unmerged work; run with -n first.

Naming branch(es) sweeps just those instead of the whole repo — same safety
rule (skipped unless merged, unless -f). Refuses to name the base or current
branch.

Usage:
  git sweep            delete local branches merged into the base (safe, -d)
  git sweep <branch...> delete just the given branch(es) (safe unless -f)
  git sweep -f         force: -D every local branch except base + current
  git sweep -n         dry run — list what would be deleted, change nothing
  git sweep -b NAME    base branch to compare against (default: origin's default)
  git sweep -h         show this help

  -f and -n combine: `git sweep -f -n` previews the force sweep.
EOF
}

dry=0
force=0
base=""
raw_targets=()   # explicit branch name(s): sweep just these instead of the whole repo
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -f|--force) force=1 ;;
    -b|--base) shift; base="${1:-}" ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "git sweep: unknown option '$1' (try -h)" >&2; exit 2 ;;
    *) raw_targets+=("$1") ;;
  esac
  shift
done

require_git_repo "git sweep"

# Refresh remote-tracking refs first (best effort; ignore offline failures) so
# "merged" is judged against origin's current tip. This is what lets sweep work
# WITHOUT first pulling the base locally, and from any branch you're on.
git fetch --prune --quiet 2>/dev/null || true

# Choose a base branch NAME if none given: origin's default (origin/HEAD), else
# main/master (local or on origin), else the current branch.
base="$(resolve_base "$base")"

# Judge "merged" against the remote-tracking tip (origin/<base>) when it exists:
# the fetch above just updated it, so a branch merged upstream is detected even
# when your local <base> is stale (no `git pull` needed) and no matter which
# branch you're on. Fall back to the local branch when offline / no remote.
if git show-ref --verify --quiet "refs/remotes/origin/$base"; then
  mergeref="origin/$base"
elif git show-ref --verify --quiet "refs/heads/$base"; then
  mergeref="$base"
else
  echo "git sweep: base '$base' not found locally or on origin" >&2; exit 1
fi

current=$(git rev-parse --abbrev-ref HEAD)

if [ "${#raw_targets[@]}" -gt 0 ]; then
  # Explicit branch(es) named: sweep just these instead of the whole repo. Same
  # safety rule applies (merged-into-base check happens below, in the deletion
  # loop) — naming a branch doesn't bypass it; --force still does.
  targets=""
  for b in "${raw_targets[@]}"; do
    if [ "$b" = "$base" ]; then
      echo "git sweep: refusing to delete the base branch '$b'" >&2; exit 2
    fi
    if [ "$b" = "$current" ]; then
      echo "git sweep: refusing to delete the current branch '$b' — switch away first" >&2; exit 2
    fi
    if ! git show-ref --verify --quiet "refs/heads/$b"; then
      warn "skipping $b — no such local branch"
      continue
    fi
    case " $targets " in *" $b "*) ;; *) targets="$targets $b" ;; esac
  done
  targets=$(echo $targets)  # trim whitespace

  if [ -z "$targets" ]; then
    echo "git sweep: none of the given branches exist locally." >&2
    exit 1
  fi
else
  # Candidate branches: with --force, every local branch; otherwise only those
  # merged into the base tip. Either way we exclude the base and the current branch.
  if [ "$force" = 1 ]; then
    list=$(git branch --format='%(refname:short)')
  else
    list=$(git branch --merged "$mergeref" --format='%(refname:short)')
  fi

  targets=""
  while IFS= read -r b; do
    [ -z "$b" ] && continue
    [ "$b" = "$base" ] && continue
    [ "$b" = "$current" ] && continue
    targets="$targets $b"
  done <<EOF
$list
EOF
  targets=$(echo $targets)  # trim whitespace

  if [ -z "$targets" ]; then
    if [ "$force" = 1 ]; then
      echo "git sweep: no other local branches to delete."
    else
      echo "git sweep: nothing merged into '$mergeref' to delete."
    fi
    exit 0
  fi
fi

if [ "$dry" = 1 ]; then
  if [ "${#raw_targets[@]}" -gt 0 ] && [ "$force" = 0 ]; then
    # Named + safe: report each branch's actual fate (some named branches may
    # not be merged yet), same check the real deletion loop below makes.
    echo "Would delete (given branches, merged into '$mergeref'):"
    for b in $targets; do
      if git merge-base --is-ancestor "$b" "$mergeref"; then
        echo "  $b"
      else
        echo "  $b ${_dim}(skip — not merged into $mergeref)${_off}"
      fi
    done
    exit 0
  fi
  if [ "${#raw_targets[@]}" -gt 0 ]; then
    echo "Would FORCE-delete (given branches):"
  elif [ "$force" = 1 ]; then
    except="'$base'"
    [ "$current" != "$base" ] && except="$except and '$current'"
    echo "Would FORCE-delete (every local branch except $except):"
  else
    echo "Would delete (merged into '$mergeref'):"
  fi
  for b in $targets; do echo "  $b"; done
  exit 0
fi

# Delete quietly and narrate each removal in the shared format (one line per
# branch) instead of leaking git's raw "Deleted branch ..." output.
_del() {  # _del <branch>
  local b="$1" sha
  sha=$(git rev-parse --short "$b" 2>/dev/null || echo '?')
  if git branch -D "$b" >/dev/null 2>&1; then
    step "deleted $b ${_dim}(was $sha)${_off}"
  else
    warn "couldn't delete $b"
  fi
}

if [ "$force" = 1 ]; then
  # Force sweep: delete every targeted branch outright (may include unmerged work).
  for b in $targets; do _del "$b"; done
else
  # Safe sweep: each target is already an ancestor of $mergeref (from --merged),
  # so deleting it can't drop unmerged work. We re-verify against $mergeref and
  # use -D rather than -d on purpose: `git branch -d` rechecks mergedness against
  # the *current* branch (local HEAD), which wrongly refuses branches merged
  # upstream when your local base is stale — the very case sweep exists to handle.
  for b in $targets; do
    if git merge-base --is-ancestor "$b" "$mergeref"; then
      _del "$b"
    else
      warn "skipped $b — not merged into $mergeref"
    fi
  done
fi
