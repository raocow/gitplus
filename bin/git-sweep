#!/usr/bin/env bash
#
# git-sweep — delete local branches already merged into the base branch.
#
# Fetches first and compares against the base's REMOTE tip (origin/<base>), so it
# works without pulling the base locally and from any branch you're on — a branch
# merged upstream is swept even if your local main is stale.
#
# Safe by default: only deletes branches whose tip is already an ancestor of the
# base's remote tip (verified with `git merge-base --is-ancestor`), so it can't
# drop unmerged work. Unlike a bare `git branch -d` it isn't fooled by a stale
# local base — `-d` rechecks against your current branch, which wrongly refuses
# branches merged upstream when local <base> lags. Note: squash-merged branches
# are NOT caught — a squash makes a new commit, so it isn't an ancestor.
#
# --force widens the net: it targets EVERY local branch (except the base and the
# current one) and force-deletes with `git branch -D` — so it also clears
# branches that were never PR'd/merged and squash-merged leftovers. This DELETES
# UNMERGED WORK; use `-n` first to see exactly what it would remove.
#
# Naming branch(es) targets just those instead of the whole repo — same rules
# apply: safe by default (skips a named branch that isn't merged, same
# ancestor check), --force deletes it regardless. Refuses to name the base or
# current branch.
#
# Local by default. -r/--remote sweeps branches on ORIGIN instead, under the
# same merged-into-base rule (judged against origin/<branch>, since the local
# copy may be stale or absent); -l/--local is that default spelled out, and
# -rl does both. Remote deletes are batched into one push — a delete is a
# network round trip, so doing them individually makes a ten-branch sweep ten
# times slower — falling back to one-at-a-time only if the batch fails, so a
# single protected branch can't take the whole sweep down with it.
#
# Deleting on origin is SHARED state: -rf force-deletes unmerged branches from
# the remote, where a mistake affects everyone rather than being recoverable
# from your own reflog. -n prints the remote section separately for that
# reason.
#
# Usage:
#   git sweep            delete local branches merged into the base (safe, -d)
#   git sweep <branch...> delete just the given branch(es) (safe unless -f)
#   git sweep -f         force: -D every local branch except base + current
#   git sweep -r         sweep branches on origin instead of local (--remote)
#   git sweep -l         local only — the default, spelled out (--local)
#   git sweep -rl        both local and origin (short flags bundle)
#   git sweep -n         dry run — list what would be deleted, change nothing
#   git sweep -b NAME    base branch to compare against (default: origin's default)
#   git sweep -h         show this help
#
set -euo pipefail

# Resolve this script's real location (following symlinks — it's installed as
# one) to find lib/gitplus-common.sh, shared across the git-* tools: the
# color/step/warn helpers and resolve_base().
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
source "$(cd -P "$(dirname "$_src")/.." && pwd)/lib/gitplus-common.sh"

usage() {
  cat <<'EOF'
git sweep — delete local branches already merged into the base branch.

Safe by default: only deletes branches already merged into the base's remote
tip (verified with merge-base), so it never drops unmerged work — and unlike a
bare `git branch -d` it isn't fooled by a stale local base. Squash-merged
branches are NOT caught (a squash isn't an ancestor).

--force targets EVERY local branch except the base and current one and deletes
with `git branch -D` — clearing never-PR'd / squash-merged / unmerged branches
too. This deletes unmerged work; run with -n first.

Naming branch(es) sweeps just those instead of the whole repo — same safety
rule (skipped unless merged, unless -f). Refuses to name the base or current
branch.

By default it only touches LOCAL branches. -r/--remote sweeps branches on
origin instead, under the same merged-into-base rule; -l/--local is the
default spelled out, and -rl does both. Deleting on origin is shared state,
so preview with -n first — and note -rf force-deletes UNMERGED branches from
the remote, where a mistake affects everyone, not just you.

Usage:
  git sweep            delete local branches merged into the base (safe, -d)
  git sweep <branch...> delete just the given branch(es) (safe unless -f)
  git sweep -f         force: -D every local branch except base + current
  git sweep -r         sweep branches on origin instead of local (--remote)
  git sweep -l         local only — the default, spelled out (--local)
  git sweep -rl        both local and origin
  git sweep -n         dry run — list what would be deleted, change nothing
  git sweep -b NAME    base branch to compare against (default: origin's default)
  git sweep -h         show this help

  -f, -n, -r and -l combine, and bundle: `git sweep -rln` previews a sweep of
  both sides; `git sweep -f -n` previews the force sweep.
EOF
}

dry=0
force=0
base=""
want_local=0     # -l seen
want_remote=0    # -r seen
raw_targets=()   # explicit branch name(s): sweep just these instead of the whole repo

# Expand bundled value-less short flags (-rl, -fn, -rlf...) into separate
# args before parsing, so `git sweep -rl` works the way anyone would expect
# it to. Only these five bundle: -b takes a value, and long options never
# bundle. Anything containing another letter is left alone and falls through
# to the unknown-option error below, rather than being silently half-read.
_args=()
for _a in "$@"; do
  case "$_a" in
    --*|-[fnrlhb]) _args+=("$_a") ;;
    -[fnrlh][fnrlh]*)
      # NOT named _ok: that's the shared green-checkmark color from
      # gitplus-common.sh, and clobbering it prefixes every ✓ line with a "1".
      _rest="${_a#-}"; _bundle_ok=1; _i=0
      while [ "$_i" -lt "${#_rest}" ]; do
        case "${_rest:$_i:1}" in f|n|r|l|h) ;; *) _bundle_ok=0; break ;; esac
        _i=$((_i + 1))
      done
      if [ "$_bundle_ok" = 1 ]; then
        _i=0
        while [ "$_i" -lt "${#_rest}" ]; do _args+=("-${_rest:$_i:1}"); _i=$((_i + 1)); done
      else
        _args+=("$_a")
      fi
      ;;
    *) _args+=("$_a") ;;
  esac
done
set -- ${_args[@]+"${_args[@]}"}

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -f|--force) force=1 ;;
    -l|--local) want_local=1 ;;
    -r|--remote) want_remote=1 ;;
    -b|--base) shift; base="${1:-}" ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "git sweep: unknown option '$1' (try -h)" >&2; exit 2 ;;
    *) raw_targets+=("$1") ;;
  esac
  shift
done

# Local-only unless told otherwise, so the bare command keeps meaning exactly
# what it always has. -r alone is remote-only; -rl (or -r -l) is both.
if [ "$want_local" = 0 ] && [ "$want_remote" = 0 ]; then
  do_local=1; do_remote=0
else
  do_local="$want_local"; do_remote="$want_remote"
fi

require_git_repo "git sweep"

# Refresh remote-tracking refs first (best effort; ignore offline failures) so
# "merged" is judged against origin's current tip. This is what lets sweep work
# WITHOUT first pulling the base locally, and from any branch you're on.
git fetch --prune --quiet 2>/dev/null || true

# Choose a base branch NAME if none given: origin's default (origin/HEAD), else
# main/master (local or on origin), else the current branch.
base="$(resolve_base "$base")"

# Judge "merged" against the remote-tracking tip (origin/<base>) when it exists:
# the fetch above just updated it, so a branch merged upstream is detected even
# when your local <base> is stale (no `git pull` needed) and no matter which
# branch you're on. Fall back to the local branch when offline / no remote.
if git show-ref --verify --quiet "refs/remotes/origin/$base"; then
  mergeref="origin/$base"
elif git show-ref --verify --quiet "refs/heads/$base"; then
  mergeref="$base"
else
  echo "git sweep: base '$base' not found locally or on origin" >&2; exit 1
fi

current=$(git rev-parse --abbrev-ref HEAD)

rtargets=""   # remote branch names (bare, no origin/ prefix) to delete

if [ "${#raw_targets[@]}" -gt 0 ]; then
  # Explicit branch(es) named: sweep just these instead of the whole repo. Same
  # safety rule applies (merged-into-base check happens below, in the deletion
  # loop) — naming a branch doesn't bypass it; --force still does.
  targets=""
  for b in "${raw_targets[@]}"; do
    if [ "$b" = "$base" ]; then
      echo "git sweep: refusing to delete the base branch '$b'" >&2; exit 2
    fi
    if [ "$b" = "$current" ]; then
      echo "git sweep: refusing to delete the current branch '$b' — switch away first" >&2; exit 2
    fi
    if [ "$do_local" = 1 ]; then
      if git show-ref --verify --quiet "refs/heads/$b"; then
        case " $targets " in *" $b "*) ;; *) targets="$targets $b" ;; esac
      else
        warn "skipping $b — no such local branch"
      fi
    fi
    if [ "$do_remote" = 1 ]; then
      if git show-ref --verify --quiet "refs/remotes/origin/$b"; then
        case " $rtargets " in *" $b "*) ;; *) rtargets="$rtargets $b" ;; esac
      else
        warn "skipping origin/$b — no such remote branch"
      fi
    fi
  done
  targets=$(echo $targets); rtargets=$(echo $rtargets)  # trim whitespace

  if [ -z "$targets" ] && [ -z "$rtargets" ]; then
    echo "git sweep: none of the given branches exist." >&2
    exit 1
  fi
else
  # Candidate branches: with --force, every branch; otherwise only those
  # merged into the base tip. Either way we exclude the base and the current branch.
  targets=""
  if [ "$do_local" = 1 ]; then
    if [ "$force" = 1 ]; then
      list=$(git branch --format='%(refname:short)')
    else
      list=$(git branch --merged "$mergeref" --format='%(refname:short)')
    fi
    while IFS= read -r b; do
      [ -z "$b" ] && continue
      [ "$b" = "$base" ] && continue
      [ "$b" = "$current" ] && continue
      targets="$targets $b"
    done <<EOF
$list
EOF
    targets=$(echo $targets)  # trim whitespace
  fi

  if [ "$do_remote" = 1 ]; then
    # Same rule on the remote side, over refs/remotes/origin/*. origin/HEAD is
    # a symref to the default branch, not a branch of its own, so it's skipped
    # — deleting it would be deleting the default branch.
    if [ "$force" = 1 ]; then
      rlist=$(git branch -r --format='%(refname:short)')
    else
      rlist=$(git branch -r --merged "$mergeref" --format='%(refname:short)')
    fi
    while IFS= read -r rb; do
      [ -z "$rb" ] && continue
      case "$rb" in origin/*) ;; *) continue ;; esac   # other remotes aren't ours to sweep
      b="${rb#origin/}"
      [ "$b" = "HEAD" ] && continue
      [ "$b" = "$base" ] && continue
      [ "$b" = "$current" ] && continue
      rtargets="$rtargets $b"
    done <<EOF
$rlist
EOF
    rtargets=$(echo $rtargets)  # trim whitespace
  fi

  if [ -z "$targets" ] && [ -z "$rtargets" ]; then
    if [ "$force" = 1 ]; then
      echo "git sweep: no other branches to delete."
    else
      echo "git sweep: nothing merged into '$mergeref' to delete."
    fi
    exit 0
  fi
fi

if [ "$dry" = 1 ]; then
  # Per-branch fate for the safe modes (some named/candidate branches may not
  # be merged), the same check the real deletion loops below make. Remote is
  # reported as its own section, and loudly: deleting a branch on origin is
  # shared state, not something to discover after the fact.
  if [ -n "$targets" ]; then
    if [ "$force" = 1 ]; then
      if [ "${#raw_targets[@]}" -gt 0 ]; then
        echo "Would FORCE-delete LOCAL (given branches):"
      else
        except="'$base'"
        [ "$current" != "$base" ] && except="$except and '$current'"
        echo "Would FORCE-delete LOCAL (every local branch except $except):"
      fi
      for b in $targets; do echo "  $b"; done
    else
      echo "Would delete LOCAL (merged into '$mergeref'):"
      for b in $targets; do
        if git merge-base --is-ancestor "$b" "$mergeref"; then
          echo "  $b"
        else
          echo "  $b ${_dim}(skip — not merged into $mergeref)${_off}"
        fi
      done
    fi
  fi
  if [ -n "$rtargets" ]; then
    [ -n "$targets" ] && echo
    if [ "$force" = 1 ]; then
      echo "Would FORCE-delete on ORIGIN ${_warn}(shared state, includes unmerged work)${_off}:"
      for b in $rtargets; do echo "  origin/$b"; done
    else
      echo "Would delete on ORIGIN ${_warn}(shared state)${_off} (merged into '$mergeref'):"
      for b in $rtargets; do
        if git merge-base --is-ancestor "origin/$b" "$mergeref"; then
          echo "  origin/$b"
        else
          echo "  origin/$b ${_dim}(skip — not merged into $mergeref)${_off}"
        fi
      done
    fi
  fi
  exit 0
fi

# Delete quietly and narrate each removal in the shared format (one line per
# branch) instead of leaking git's raw "Deleted branch ..." output.
_del() {  # _del <branch>
  local b="$1" sha
  sha=$(git rev-parse --short "$b" 2>/dev/null || echo '?')
  if git branch -D "$b" >/dev/null 2>&1; then
    step "deleted $b ${_dim}(was $sha)${_off}"
  else
    warn "couldn't delete $b"
  fi
}

if [ "$force" = 1 ]; then
  # Force sweep: delete every targeted branch outright (may include unmerged work).
  for b in $targets; do _del "$b"; done
else
  # Safe sweep: each target is already an ancestor of $mergeref (from --merged),
  # so deleting it can't drop unmerged work. We re-verify against $mergeref and
  # use -D rather than -d on purpose: `git branch -d` rechecks mergedness against
  # the *current* branch (local HEAD), which wrongly refuses branches merged
  # upstream when your local base is stale — the very case sweep exists to handle.
  for b in $targets; do
    if git merge-base --is-ancestor "$b" "$mergeref"; then
      _del "$b"
    else
      warn "skipped $b — not merged into $mergeref"
    fi
  done
fi

# --- remote ---------------------------------------------------------------
# Same safety rule, judged against origin/<branch> rather than the local ref,
# since a local copy can be stale or absent entirely.
if [ -n "$rtargets" ]; then
  rdel=""
  for b in $rtargets; do
    if [ "$force" = 1 ] || git merge-base --is-ancestor "origin/$b" "$mergeref"; then
      rdel="$rdel $b"
    else
      warn "skipped origin/$b — not merged into $mergeref"
    fi
  done
  rdel=$(echo $rdel)

  if [ -n "$rdel" ]; then
    # One push for the whole set: a delete is a network round trip, and doing
    # them one at a time makes a ten-branch sweep ten times slower for no
    # benefit. If the batch fails, fall back to individual pushes so the
    # failure is attributed to the branch that actually caused it rather than
    # taking the whole sweep down with it.
    if git push --quiet origin --delete $rdel >/dev/null 2>&1; then
      for b in $rdel; do step "deleted origin/$b"; done
    else
      for b in $rdel; do
        if git push --quiet origin --delete "$b" >/dev/null 2>&1; then
          step "deleted origin/$b"
        else
          warn "couldn't delete origin/$b (protected, already gone, or no permission)"
        fi
      done
    fi
  fi
fi
