#autoload
#
# Completion for `git sweep` — real branches (via _gitplus_branch_names) as
# positional targets, alongside flags, and as -b's value. Flags are always
# offered on a bare TAB (not gated behind typing '-' first) — unlike git-pr's
# ids-first design, sweep's flags (-f, -n) are common enough to want visible
# up front, and hiding them would be a regression from before sweep took
# positional targets at all.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  _message -r 'not inside a git repository'; return
fi
case ${words[CURRENT-1]} in
  -b|--base) _gitplus_branch_names; return ;;
esac
_alternative \
  'flags:Flag:(-f --force -n --dry-run -b --base -h --help)' \
  'branches:Branch:_gitplus_branch_names'
