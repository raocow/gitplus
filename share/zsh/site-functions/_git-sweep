#autoload
#
# Completion for `git sweep` — real branches (via _gitplus_branch_names) as
# positional targets and as -b's value. Flags only surface once you've typed
# a leading '-', so a bare TAB leads with branches — the point of naming one.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  _message -r 'not inside a git repository'; return
fi
case ${words[CURRENT-1]} in
  -b|--base) _gitplus_branch_names; return ;;
esac
if [[ $PREFIX == -* ]]; then
  _alternative 'flags:Flag:(-f --force -n --dry-run -b --base -h --help)'
  return
fi
_gitplus_branch_names
